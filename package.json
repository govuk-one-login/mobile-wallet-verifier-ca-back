{
  "name": "mobile-wallet-verifier-ca-back",
  "version": "1.0.0",
  "description": "Mobile wallet verifier CA backend services",
  "type": "module",
  "scripts": {
    "postinstall": "husky || true",
    "build": "mkdir -p dist && cp -f open-api-spec.yaml dist/ && node build.mjs",
    "test": "./node_modules/.bin/vitest run",
    "test:cov": "./node_modules/.bin/vitest run --coverage",
    "lint": "./node_modules/.bin/eslint .",
    "format": "./node_modules/.bin/prettier --write '**/*.{json,md,ts}'",
    "format:check": "./node_modules/.bin/prettier --check '**/*.{json,md,ts}'",
    "infra:format:check": "rain fmt --verify application.yaml",
    "infra:format": "rain fmt --write application.yaml",
    "test:integration": "./node_modules/@cucumber/cucumber/bin/cucumber.js"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.35.0",
    "@aws-sdk/client-acm-pca": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@peculiar/asn1-schema": "2.6.0",
    "@peculiar/asn1-x509": "2.6.0",
    "@peculiar/x509": "2.1.0",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@cucumber/cucumber": "13.2.1",
    "@eslint/js": "9.39.2",
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "@types/aws-lambda": "8.10.164",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "js-yaml": "5.4.2",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
